# Edge function secrets that are NOT auto-injected by the Supabase CLI
# runtime (SUPABASE_URL, SUPABASE_ANON_KEY and SERVICE_ROLE_KEY
# already are -- don't add those here).
#
# For local dev: copy this to supabase/functions/.env (gitignored) and
# `supabase functions serve` will pick it up automatically.
# For deployed environments: set with
#   supabase secrets set WEBSITE_ALLOWED_ORIGINS=https://coreverse.dev,https://staging.coreverse.dev

# Comma-separated, exact origins (scheme + host + port, no trailing
# slash) the CORS layer (_shared/http.ts withCors) allows, and that
# POST /auth/password-reset's redirectTo is checked against. Must match
# whatever the Website is actually served from in that environment.
WEBSITE_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- send-email function (Supabase Auth "Send Email" hook target) ---
# Not read by any other function. See supabase/functions/send-email/index.ts.

# Generated by Supabase Dashboard -> Authentication -> Hooks -> Send
# Email hook when you point it at this function's URL. Copy the value
# as-is (including the `v1,whsec_` prefix -- the function strips it).
SEND_EMAIL_HOOK_SECRET=v1,whsec_examplebase64secret

# Same Brevo account/sender the Website already uses
# (src/services/brevo.ts) -- keep these in sync with the Website's own
# BREVO_* env vars so mail comes from the same address either way.
BREVO_API_KEY=
BREVO_SENDER_EMAIL=coreverseengine@gmail.com
BREVO_SENDER_NAME="Coreverse Engine"
