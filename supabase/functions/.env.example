# Edge function secrets that are NOT auto-injected by the Supabase CLI
# runtime (SUPABASE_URL, SUPABASE_ANON_KEY and SUPABASE_SERVICE_ROLE_KEY
# already are -- don't add those here).
#
# For local dev: copy this to supabase/functions/.env (gitignored) and
# `supabase functions serve` will pick it up automatically.
# For deployed environments: set with
#   supabase secrets set WEBSITE_ALLOWED_ORIGINS=https://coreverse.dev,https://staging.coreverse.dev

# Comma-separated, exact origins (scheme + host + port, no trailing
# slash) the CORS layer (_shared/http.ts withCors) allows, and that
# POST /auth/password-reset's redirectTo is checked against. Must match
# whatever the Website is actually served from in that environment.
WEBSITE_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
