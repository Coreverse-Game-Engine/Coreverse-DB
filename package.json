{
  "name": "@Coreverse-Game-Engine/db-client",
  "version": "0.6.0",
  "description": "Typed TypeScript client (+ optional TanStack Query React hooks) for the Coreverse DB API, generated from openapi/openapi.yaml.",
  "type": "module",
  "license": "GPL-3.0-only",
  "author": "Coreverse-Game-Engine",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Coreverse-Game-Engine/Coreverse-DB.git"
  },
  "homepage": "https://github.com/Coreverse-Game-Engine/Coreverse-DB#readme",
  "bugs": {
    "url": "https://github.com/Coreverse-Game-Engine/Coreverse-DB/issues"
  },
  "keywords": [
    "coreverse",
    "supabase",
    "openapi",
    "typescript",
    "react",
    "tanstack-query",
    "sdk",
    "api-client"
  ],
  "files": [
    "dist"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": {
        "import": "./dist/index.d.ts",
        "require": "./dist/index.d.cts"
      },
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./react": {
      "types": {
        "import": "./dist/react.d.ts",
        "require": "./dist/react.d.cts"
      },
      "import": "./dist/react.js",
      "require": "./dist/react.cjs"
    }
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "generate": "orval --config orval.config.ts",
    "typecheck": "tsc --noEmit",
    "check:version-sync": "node scripts/check-version-sync.mjs",
    "verify": "pnpm run check:version-sync && pnpm run generate && git diff --exit-code src/generated && pnpm run typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "build": "tsup",
    "prepublishOnly": "pnpm run build"
  },
  "dependencies": {
    "zod": "^4.6.5"
  },
  "peerDependencies": {
    "@tanstack/react-query": "^5",
    "react": ">=18"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "@tanstack/react-query": {
      "optional": true
    }
  },
  "devDependencies": {
    "@redocly/cli": "^2.76.0",
    "@tanstack/react-query": "^5",
    "@types/node": "^26.6.6",
    "@types/react": "^19.2.18",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@vitest/coverage-v8": "^5.1.0",
    "orval": "^8.46.0",
    "prettier": "^3.9.10",
    "react": "^19.3.1",
    "tsup": "^9.0.0",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vitest": "^5.1.0"
  },
  "packageManager": "pnpm@12.18.0+sha512.9d7882d5dc82147ecfc4e062aa34834e0ad0296710a1837a1115ae012127d36b7109e321ac1598a1dd0a65597681b1e99917e12ed0d749eae91187943363beb3"
}
