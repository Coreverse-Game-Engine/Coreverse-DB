{
  "name": "@Coreverse-Game-Engine/db-client",
  "version": "0.4.2",
  "description": "Typed TypeScript client (+ optional TanStack Query React hooks) for the Coreverse DB API, generated from openapi/openapi.yaml.",
  "type": "module",
  "license": "GPL-3.0-only",
  "author": "Coreverse-Game-Engine",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Coreverse-Game-Engine/Coreverse-DB.git"
  },
  "homepage": "https://github.com/Coreverse-Game-Engine/Coreverse-DB#readme",
  "bugs": {
    "url": "https://github.com/Coreverse-Game-Engine/Coreverse-DB/issues"
  },
  "keywords": [
    "coreverse",
    "supabase",
    "openapi",
    "typescript",
    "react",
    "tanstack-query",
    "sdk",
    "api-client"
  ],
  "files": [
    "dist"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": {
        "import": "./dist/index.d.ts",
        "require": "./dist/index.d.cts"
      },
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./react": {
      "types": {
        "import": "./dist/react.d.ts",
        "require": "./dist/react.d.cts"
      },
      "import": "./dist/react.js",
      "require": "./dist/react.cjs"
    }
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "generate": "orval --config orval.config.ts",
    "typecheck": "tsc --noEmit",
    "check:version-sync": "node scripts/check-version-sync.mjs",
    "verify": "pnpm run check:version-sync && pnpm run generate && git diff --exit-code src/generated && pnpm run typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "build": "tsup",
    "prepublishOnly": "pnpm run build"
  },
  "dependencies": {
    "zod": "^4.5.4"
  },
  "peerDependencies": {
    "@tanstack/react-query": "^5",
    "react": ">=18"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "@tanstack/react-query": {
      "optional": true
    }
  },
  "devDependencies": {
    "@redocly/cli": "^2.49.1",
    "@tanstack/react-query": "^5",
    "@types/node": "^22.18.13",
    "@types/react": "^19.2.18",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@vitest/coverage-v8": "^5.0.1",
    "orval": "^8.27.0",
    "prettier": "^3.9.6",
    "react": "^19.2.8",
    "tsup": "^8.5.1",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vitest": "^5.0.1"
  },
  "packageManager": "pnpm@12.5.1+sha512.e3f305bc784a2bc89f5ad3b6138889470fae8d2af5f36b61216ec91c2c3d64089775f9de38aac331044ea40f245cb0d5666392dfdf65824e1907ef6a2c62de5f"
}
